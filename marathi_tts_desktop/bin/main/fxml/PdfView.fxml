<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marathitts.desktop.controller.PdfController"
            stylesheets="@../css/style.css">
    <center>
        <VBox spacing="10" styleClass="panel">
            <padding><Insets topRightBottomLeft="14"/></padding>
            <Label text="PDF Text Extraction" styleClass="section-label"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="browseBtn" text="📂 Browse PDF"
                        onAction="#onBrowse" styleClass="btn-secondary"/>
                <Label fx:id="fileLabel" text="No file selected" styleClass="file-label" HBox.hgrow="ALWAYS"/>
                <Button fx:id="extractBtn" text="📝 Extract" onAction="#onExtract"
                        styleClass="btn-primary" disable="true"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="methodLabel" styleClass="method-label"/>
            </HBox>

            <TextArea fx:id="textArea" wrapText="true" VBox.vgrow="ALWAYS"
                      editable="true" styleClass="marathi-text-area"
                      promptText="Extracted Marathi text will appear here…"/>

            <HBox spacing="8">
                <Button fx:id="sendToTtsBtn" text="🔊 Send to TTS"
                        onAction="#onSendToTts" styleClass="btn-success"
                        disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Clear" onAction="#onClear" styleClass="btn-secondary"/>
            </HBox>

            <ProgressBar fx:id="progressBar" maxWidth="Infinity" visible="false"/>
            <Label fx:id="statusLabel" text="Ready" styleClass="status-text"/>
        </VBox>
    </center>
</BorderPane>
