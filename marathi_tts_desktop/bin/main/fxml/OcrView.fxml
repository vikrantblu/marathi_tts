<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marathitts.desktop.controller.OcrController"
            stylesheets="@../css/style.css">
    <center>
        <SplitPane dividerPositions="0.45">

            <!-- Image pane -->
            <VBox spacing="10" styleClass="card-panel">
                <padding><Insets topRightBottomLeft="20"/></padding>
                <Label text="Input Image" styleClass="section-label"/>
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                    <ImageView fx:id="imageView" fitWidth="400" fitHeight="400" preserveRatio="true"/>
                </ScrollPane>
                <HBox spacing="8">
                    <Button fx:id="browseBtn" text="📂 Browse Image"
                            onAction="#onBrowseImage" styleClass="btn-secondary" HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>
                    <Button fx:id="extractBtn" text="📝 Extract Text"
                            onAction="#onExtract" styleClass="btn-primary"
                            disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <ProgressBar fx:id="progressBar" maxWidth="Infinity" visible="false"/>
                <Label fx:id="statusLabel" text="Select an image to begin" styleClass="status-text"/>
            </VBox>

            <!-- Text result pane -->
            <VBox spacing="10" styleClass="card-panel">
                <padding><Insets topRightBottomLeft="20"/></padding>
                <Label text="Extracted Text" styleClass="section-label"/>
                <TextArea fx:id="extractedTextArea" wrapText="true" editable="true"
                          VBox.vgrow="ALWAYS" styleClass="marathi-text-area"/>
                <HBox spacing="8">
                    <Button fx:id="sendToTtsBtn" text="🔊 Send to TTS"
                            onAction="#onSendToTts" styleClass="btn-success"
                            disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Clear" onAction="#onClear" styleClass="btn-secondary"/>
                </HBox>
            </VBox>

        </SplitPane>
    </center>
</BorderPane>
