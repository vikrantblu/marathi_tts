<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marathitts.desktop.controller.MainController"
            stylesheets="@../css/style.css">

    <!-- ── Top toolbar ───────────────────────────────────────────────── -->
    <top>
        <VBox styleClass="toolbar">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                <Label text="🟠 मराठी TTS" styleClass="app-title"/>
                <Separator orientation="VERTICAL" prefHeight="24"/>
                <Label text="Project root:" styleClass="status-text"/>
                <TextField fx:id="projectRootField" prefWidth="300"
                           promptText="/path/to/marathi_tts_web  (or leave blank for embedded engine)"/>
                <Button text="Browse…" onAction="#onBrowseProjectRoot" styleClass="btn-outline"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="v2.0" styleClass="chip-label"/>
            </HBox>
        </VBox>
    </top>

    <!-- ── Centre: tab pane ──────────────────────────────────────────── -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

            <!-- TTS Tab -->
            <Tab text="🔊  TTS">
                <fx:include fx:id="ttsView" source="TtsView.fxml"/>
            </Tab>

            <!-- Emotion Tab -->
            <Tab text="😊  Emotion">
                <fx:include fx:id="emotionView" source="EmotionView.fxml"/>
            </Tab>

            <!-- OCR Tab -->
            <Tab text="📷  Image OCR">
                <fx:include fx:id="ocrView" source="OcrView.fxml"/>
            </Tab>

            <!-- Correction Tab -->
            <Tab text="✏️  Correction">
                <fx:include fx:id="correctionView" source="CorrectionView.fxml"/>
            </Tab>

            <!-- PDF Tab -->
            <Tab text="📄  PDF">
                <fx:include fx:id="pdfView" source="PdfView.fxml"/>
            </Tab>

            <!-- Web Fetch Tab -->
            <Tab text="🌐  Web Fetch">
                <fx:include fx:id="webFetchView" source="WebFetchView.fxml"/>
            </Tab>

            <!-- STT Tab (new) -->
            <Tab text="🎙  Speech-to-Text">
                <fx:include fx:id="sttView" source="SttView.fxml"/>
            </Tab>

            <!-- Modi Script Tab (new) -->
            <Tab text="𑘦  Script Converter">
                <fx:include fx:id="modiView" source="ModiView.fxml"/>
            </Tab>

        </TabPane>
    </center>

    <!-- ── Status bar ────────────────────────────────────────────────── -->
    <bottom>
        <HBox styleClass="status-bar" spacing="10" alignment="CENTER_LEFT">
            <ProgressBar fx:id="progressBar" prefWidth="100" visible="false" prefHeight="4"/>
            <Label fx:id="statusBar" text="Ready" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Marathi TTS Desktop" styleClass="chip-label"/>
        </HBox>
    </bottom>

</BorderPane>
