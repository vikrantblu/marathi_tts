<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<SplitPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.marathitts.desktop.controller.StotraController"
           dividerPositions="0.35" orientation="HORIZONTAL"
           stylesheets="@../css/style.css">

    <!-- Left: Stotra list with search + deity filter -->
    <VBox spacing="10" styleClass="card-panel">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label text="📿 स्तोत्र संग्रह" styleClass="section-label"/>

        <!-- Search -->
        <TextField fx:id="searchField" promptText="🔍 Search stotras…"/>

        <!-- Deity filter chips -->
        <HBox fx:id="deityFilterBox" spacing="6" alignment="CENTER_LEFT">
            <ToggleButton fx:id="filterAll" text="All" selected="true" styleClass="chip-label"/>
            <ToggleButton text="गणेश" styleClass="chip-label"/>
            <ToggleButton text="विष्णु" styleClass="chip-label"/>
            <ToggleButton text="शिव" styleClass="chip-label"/>
            <ToggleButton text="देवी" styleClass="chip-label"/>
            <ToggleButton text="हनुमान" styleClass="chip-label"/>
            <ToggleButton text="राम" styleClass="chip-label"/>
            <ToggleButton text="कृष्ण" styleClass="chip-label"/>
        </HBox>

        <!-- Stotra list -->
        <ListView fx:id="stotraListView" VBox.vgrow="ALWAYS"/>

        <Label fx:id="countLabel" text="0 stotras" styleClass="status-text"/>
    </VBox>

    <!-- Right: Stotra detail view -->
    <VBox spacing="10" styleClass="card-panel">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label fx:id="stotraTitle" text="Select a stotra…" styleClass="section-label"
               wrapText="true"/>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="deityLabel" text="" styleClass="chip-label"/>
            <Label fx:id="languageLabel" text="" styleClass="chip-label"/>
            <Label fx:id="meterLabel" text="" styleClass="chip-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="sourceLabel" text="" styleClass="status-text"/>
        </HBox>

        <TextArea fx:id="stotraTextArea" wrapText="true" editable="false"
                  VBox.vgrow="ALWAYS" style="-fx-font-family: 'Noto Sans Devanagari', 'Mangal'; -fx-font-size: 15;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="sendToTtsBtn" text="🔊 TTS ला पाठवा" onAction="#onSendToTts"
                    styleClass="btn-primary" disable="true"/>
            <Button fx:id="playBtn" text="▶ Play" onAction="#onPlayStotra"
                    styleClass="btn-outline" disable="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="" styleClass="status-text"/>
        </HBox>

        <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="4" visible="false"/>
    </VBox>

</SplitPane>
