<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marathitts.desktop.controller.SttController"
            stylesheets="@../css/style.css">

    <center>
        <SplitPane orientation="HORIZONTAL" dividerPositions="0.52">

            <!-- Left: Record / Upload -->
            <VBox spacing="0" styleClass="card-panel">
                <padding><Insets topRightBottomLeft="20"/></padding>

                <Label text="Speech to Text" styleClass="tab-title"/>
                <Label text="Upload an audio file or record from microphone"
                       styleClass="tab-subtitle"/>
                <Region prefHeight="16"/>

                <!-- Audio file picker -->
                <VBox styleClass="section-card" spacing="10">
                    <Label text="Audio File" styleClass="section-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="audioFileLabel" text="No file selected"
                               styleClass="file-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Browse…" onAction="#onBrowseAudio" styleClass="btn-outline"/>
                    </HBox>
                    <Button fx:id="transcribeBtn" text="🎙 Transcribe File" maxWidth="Infinity"
                            onAction="#onTranscribe" styleClass="btn-primary" disable="true"/>
                </VBox>

                <Region prefHeight="12"/>

                <!-- Microphone recorder -->
                <VBox styleClass="section-card" spacing="10">
                    <Label text="Record from Microphone" styleClass="section-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Duration"/>
                        <Slider fx:id="recordDurationSlider" min="3" max="30" value="5"
                                showTickLabels="true" majorTickUnit="5" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="durationLabel" text="5s" styleClass="value-label" minWidth="30"/>
                    </HBox>
                    <Button fx:id="recordBtn" text="⏺ Record &amp; Transcribe" maxWidth="Infinity"
                            onAction="#onRecord" styleClass="btn-record"/>
                </VBox>

                <Region prefHeight="12"/>

                <!-- Language -->
                <VBox styleClass="section-card" spacing="8">
                    <Label text="Recognition Language" styleClass="section-label"/>
                    <ComboBox fx:id="languageCombo" maxWidth="Infinity"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>
                <ProgressBar fx:id="progressBar" maxWidth="Infinity" visible="false"/>
                <Label fx:id="statusLabel" text="Ready" styleClass="status-text" wrapText="true"/>
            </VBox>

            <!-- Right: Results -->
            <VBox spacing="0" styleClass="card-panel">
                <padding><Insets topRightBottomLeft="20"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Transcript" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="engineLabel" text="" styleClass="chip-label"/>
                </HBox>
                <Region prefHeight="8"/>

                <TextArea fx:id="outputArea" wrapText="true" prefRowCount="10"
                          promptText="Transcription will appear here…"
                          VBox.vgrow="ALWAYS" styleClass="marathi-text-area"/>

                <Region prefHeight="12"/>
                <Label text="Segments (with timestamps)" styleClass="section-label-small"/>
                <Region prefHeight="6"/>
                <TextArea fx:id="segmentsArea" wrapText="true" prefRowCount="6"
                          promptText="[0.0s–1.2s] segment text…"
                          styleClass="mono-text-area" editable="false"/>

                <Region prefHeight="12"/>
                <HBox spacing="8">
                    <Button fx:id="sendToTtsBtn" text="→ Send to TTS" onAction="#onSendToTts"
                            styleClass="btn-success" disable="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Clear" onAction="#onClear" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

        </SplitPane>
    </center>
</BorderPane>
