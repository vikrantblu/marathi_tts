<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marathitts.desktop.controller.HistoryController"
            stylesheets="@../css/style.css">

    <!-- Top toolbar: filter chips + Clear All -->
    <top>
        <VBox styleClass="toolbar">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Generation History" styleClass="section-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text="0 entries" styleClass="status-text"/>
                <Button text="🗑 Clear All" onAction="#onClearAll" styleClass="btn-ghost"/>
            </HBox>
            <!-- Category filter chips -->
            <HBox fx:id="filterBox" spacing="6" alignment="CENTER_LEFT">
                <padding><Insets top="4" right="0" bottom="4" left="0"/></padding>
                <ToggleButton fx:id="filterAll"   text="All"         selected="true" styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterTts"   text="TTS"                         styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterStt"   text="STT"                         styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterOcr"   text="OCR"                         styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterPdf"   text="PDF"                         styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterWeb"   text="Web"                         styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterCorr"  text="Correction"                  styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterModi"  text="Modi"                        styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterEmot"  text="Emotion"                     styleClass="chip-label" onAction="#onFilter"/>
                <ToggleButton fx:id="filterStotra" text="Stotra"                     styleClass="chip-label" onAction="#onFilter"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: list left, detail right -->
    <center>
        <SplitPane dividerPositions="0.40">

            <!-- History list -->
            <VBox styleClass="card-panel">
                <padding><Insets topRightBottomLeft="10"/></padding>
                <ListView fx:id="historyList" VBox.vgrow="ALWAYS"
                          styleClass="history-list"/>
                <Label fx:id="emptyLabel" text="No history yet. Generate some audio or run OCR!"
                       styleClass="hint-label" wrapText="true" visible="false"
                       style="-fx-padding: 20; -fx-text-alignment: center;"/>
            </VBox>

            <!-- Detail pane -->
            <VBox spacing="10" styleClass="card-panel">
                <padding><Insets topRightBottomLeft="20"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="detailCategoryBadge" text="" styleClass="chip-label"/>
                    <Label fx:id="detailTimeLabel" text="" styleClass="status-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="detailCopyBtn" text="📋 Copy" onAction="#onDetailCopy"
                            styleClass="btn-ghost" disable="true"/>
                    <Button fx:id="detailSendToTtsBtn" text="→ TTS" onAction="#onDetailSendToTts"
                            styleClass="btn-success" disable="true"/>
                    <Button fx:id="detailDeleteBtn" text="🗑" onAction="#onDetailDelete"
                            styleClass="btn-ghost" disable="true"/>
                </HBox>

                <Label text="Input" styleClass="section-label-small"/>
                <TextArea fx:id="detailInputArea" wrapText="true" editable="false"
                          prefRowCount="4" styleClass="marathi-text-area"/>

                <Label text="Output" styleClass="section-label-small"/>
                <TextArea fx:id="detailOutputArea" wrapText="true" editable="false"
                          VBox.vgrow="ALWAYS" styleClass="marathi-text-area"/>

                <Label fx:id="detailAudioLabel" text="" styleClass="hint-label" wrapText="true"/>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>
