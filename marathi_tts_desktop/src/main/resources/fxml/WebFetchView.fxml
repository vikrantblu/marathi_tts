<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marathitts.desktop.controller.WebFetchController"
            stylesheets="@../css/style.css">
    <top>
        <VBox styleClass="toolbar">
            <padding><Insets topRightBottomLeft="10"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="URL:"/>
                <TextField fx:id="urlField" promptText="https://maharashtratimes.com/…"
                           HBox.hgrow="ALWAYS" onAction="#onFetch"/>
                <Button fx:id="fetchBtn" text="🌐 Fetch" onAction="#onFetch"
                        styleClass="btn-primary"/>
                <Button text="Clear" onAction="#onClear" styleClass="btn-secondary"/>
            </HBox>
            <Label fx:id="titleLabel" styleClass="page-title-label" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="8" styleClass="panel">
            <padding><Insets topRightBottomLeft="12"/></padding>
            <TextArea fx:id="textArea" wrapText="true" editable="true"
                      VBox.vgrow="ALWAYS" styleClass="marathi-text-area"
                      promptText="Fetched Marathi text will appear here…"/>
            <HBox spacing="8">
                <Button fx:id="sendToTtsBtn" text="🔊 Send to TTS"
                        onAction="#onSendToTts" styleClass="btn-success"
                        disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <ProgressBar fx:id="progressBar" maxWidth="Infinity" visible="false"/>
            <Label fx:id="statusLabel" text="Enter a URL above and click Fetch"
                   styleClass="status-text"/>
        </VBox>
    </center>
</BorderPane>
