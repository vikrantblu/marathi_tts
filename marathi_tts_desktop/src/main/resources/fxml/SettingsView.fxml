<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marathitts.desktop.controller.SettingsController"
            stylesheets="@../css/style.css">
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16" maxWidth="700">
                <padding><Insets topRightBottomLeft="24"/></padding>

                <Label text="Settings" styleClass="tab-title"/>
                <Label text="Preferences are saved automatically and applied on next generate / app start."
                       styleClass="tab-subtitle" wrapText="true"/>

                <Region prefHeight="4"/>

                <!-- ── TTS Defaults ──────────────────────────────────── -->
                <VBox styleClass="section-card" spacing="12">
                    <Label text="TTS Defaults" styleClass="section-label"/>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Engine" prefWidth="80"/>
                        <ComboBox fx:id="defaultEngineCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Voice" prefWidth="80"/>
                        <ComboBox fx:id="defaultGenderCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Speed" prefWidth="80"/>
                        <Slider fx:id="defaultSpeedSlider" min="0.5" max="2.0" value="1.0"
                                HBox.hgrow="ALWAYS" showTickLabels="true" showTickMarks="true"
                                majorTickUnit="0.5" snapToTicks="false"/>
                        <Label fx:id="defaultSpeedLabel" text="1.0×" styleClass="value-label" minWidth="42"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Pitch" prefWidth="80"/>
                        <Slider fx:id="defaultPitchSlider" min="0.5" max="2.0" value="1.0"
                                HBox.hgrow="ALWAYS" showTickLabels="true" showTickMarks="true"
                                majorTickUnit="0.5" snapToTicks="false"/>
                        <Label fx:id="defaultPitchLabel" text="1.0" styleClass="value-label" minWidth="42"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Volume" prefWidth="80"/>
                        <Slider fx:id="defaultVolumeSlider" min="0.1" max="2.0" value="1.0"
                                HBox.hgrow="ALWAYS" showTickLabels="true" showTickMarks="true"
                                majorTickUnit="0.5" snapToTicks="false"/>
                        <Label fx:id="defaultVolumeLabel" text="100%" styleClass="value-label" minWidth="42"/>
                    </HBox>
                </VBox>

                <!-- ── Data Management ───────────────────────────────── -->
                <VBox styleClass="section-card" spacing="10">
                    <Label text="Data Management" styleClass="section-label"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="🗑  Clear History"
                                onAction="#onClearHistory" styleClass="btn-secondary"/>
                        <Label text="Removes all generation history from memory."
                               styleClass="hint-label" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="📝  Clear TTS Draft"
                                onAction="#onClearDraft" styleClass="btn-secondary"/>
                        <Label text="Removes the auto-saved TTS text draft."
                               styleClass="hint-label" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="🔖  Clear URL Bookmarks"
                                onAction="#onClearBookmarks" styleClass="btn-secondary"/>
                        <Label text="Removes saved web URL bookmarks."
                               styleClass="hint-label" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="🕐  Clear Recent TTS Chips"
                                onAction="#onClearRecentChips" styleClass="btn-secondary"/>
                        <Label text="Removes recent TTS input suggestions."
                               styleClass="hint-label" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="🔄  Reset to Defaults"
                                onAction="#onResetDefaults" styleClass="btn-secondary"/>
                        <Label text="Restores speed, pitch, volume to 1.0, engine to Auto."
                               styleClass="hint-label" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <Label fx:id="statusLabel" text="" styleClass="status-text"/>

                <!-- ── About ─────────────────────────────────────────── -->
                <VBox styleClass="section-card" spacing="8">
                    <Label text="About" styleClass="section-label"/>
                    <Label text="🟠  Marathi TTS Desktop  v2.0" styleClass="tab-title"/>
                    <Label wrapText="true" styleClass="hint-label"
                           text="A full-featured Marathi text-to-speech application with support for phonetic processing, emotion detection, OCR, PDF reading, web fetching, stotra library, and more."/>
                    <Label wrapText="true" styleClass="hint-label"
                           text="TTS Engines: Google TTS (gTTS) · Edge-TTS · System TTS"/>
                    <Label wrapText="true" styleClass="hint-label"
                           text="NLP: Marathi G2P · SandhiEngine · ProsodyEngine · MetreEngine · GrammarEngine · MorphologicalAnalyzer"/>
                    <Label wrapText="true" styleClass="hint-label"
                           text="Languages: Marathi · Hindi · Sanskrit · English"/>
                </VBox>

                <Region prefHeight="20"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
