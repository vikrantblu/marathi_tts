# ─────────────────────────────────────────────────────────────────────────────
# Marathi TTS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
DJANGO_SECRET_KEY=your-secret-key-here          # Required in production
DJANGO_DEBUG=True                                # Set to False in production

# Allowed hosts — comma-separated list
# Example: DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Admin panel URL slug (change from default to obscure the admin URL)
DJANGO_ADMIN_URL=admin/

# CORS — comma-separated origins allowed to call the API
# Example: CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:9000,http://127.0.0.1:8888

# CSRF trusted origins — comma-separated
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:9000,http://127.0.0.1:8888

# Database (defaults to SQLite — override for PostgreSQL in production)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# TTS settings
TTS_MAX_TEXT_LENGTH=25000
TTS_DEFAULT_VOICE=google
TTS_CHUNK_SIZE=1000

# Tesseract OCR language (Marathi)
TESSERACT_LANGUAGE=mar

# Optional: path to Tesseract binary (leave blank if it's in PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# Optional: Google Cloud / Azure credentials (if using cloud TTS)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# AZURE_SPEECH_KEY=your-azure-key
# AZURE_SPEECH_REGION=eastus

# Optional: Indic NLP resources
# INDIC_NLP_RESOURCES=/path/to/indic_nlp_resources
# INDIC_NLP_LIB=/path/to/indic_nlp_library
