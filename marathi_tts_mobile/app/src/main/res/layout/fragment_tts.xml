<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Text input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_marathi_text"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_marathi_text"
                android:minLines="5"
                android:maxLines="12"
                android:inputType="textMultiLine"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/char_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 chars"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"/>

        <!-- TTS Engine selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_tts_engine"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"/>
        <Spinner
            android:id="@+id/engine_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/engine_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="8dp"/>

        <!-- Language selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_language"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:layout_marginBottom="4dp"/>
        <Spinner
            android:id="@+id/language_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <!-- Voice Gender selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_voice_gender"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:layout_marginBottom="4dp"/>
        <Spinner
            android:id="@+id/gender_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <!-- Voice settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_voice_settings"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_speed"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/speed_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="5"
                    android:valueTo="20"
                    android:value="10"
                    android:stepSize="1"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_pitch"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/pitch_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="5"
                    android:valueTo="20"
                    android:value="10"
                    android:stepSize="1"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_volume"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/volume_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="20"
                    android:value="10"
                    android:stepSize="1"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Emotion -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_emotion"/>
        <Spinner
            android:id="@+id/emotion_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>

        <!-- Auto-detect emotion -->        
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/auto_detect_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-detect emotion from text"
            android:layout_marginBottom="4dp"/>

        <!-- Verse mode -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/verse_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verse_mode"
            android:layout_marginBottom="12dp"/>

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/generate_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_generate"
            android:layout_marginBottom="8dp"/>

        <!-- Audio controls (shown after generation) -->
        <LinearLayout
            android:id="@+id/audio_control_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/play_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏹"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_audio_btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_save"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedback_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_feedback"
                android:enabled="false"/>

        </LinearLayout>

        <TextView
            android:id="@+id/engine_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear"
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginTop="4dp"/>

    </LinearLayout>
</ScrollView>
