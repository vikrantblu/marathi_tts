<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Playlist check indicator (visible only in playlist mode) -->
        <TextView
            android:id="@+id/playlist_check"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="?attr/colorPrimary"
            android:background="@drawable/playlist_check_bg"
            android:visibility="gone"
            android:layout_marginEnd="10dp"
            tools:text="✓"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <!-- Row 1: title + deity badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stotra_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="श्री गणपती अथर्वशीर्ष"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/deity_chip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                app:chipMinHeight="28dp"
                android:textSize="12sp"
                app:chipCornerRadius="14dp"
                tools:text="गणेश"/>
        </LinearLayout>

        <!-- Row 2: English title -->
        <TextView
            android:id="@+id/stotra_title_en"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="2dp"
            tools:text="Shri Ganapati Atharvashirsha"/>

        <!-- Row 3: meta info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/lang_chip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:chipMinHeight="24dp"
                android:textSize="11sp"
                app:chipCornerRadius="12dp"
                style="@style/Widget.Material3.Chip.Assist"
                tools:text="संस्कृत"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/category_chip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:chipMinHeight="24dp"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                app:chipCornerRadius="12dp"
                style="@style/Widget.Material3.Chip.Assist"
                tools:text="स्तोत्र"/>

            <TextView
                android:id="@+id/verse_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="29 verses"/>
        </LinearLayout>

        </LinearLayout>  <!-- end content column -->

    </LinearLayout>  <!-- end horizontal wrapper -->

</com.google.android.material.card.MaterialCardView>
