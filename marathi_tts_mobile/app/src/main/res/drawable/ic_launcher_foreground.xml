<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: Devanagari "म" (Ma — for Marathi) in white,
    centred on the 108 dp adaptive-icon safe zone.
    A speech-bubble arc sits behind the letter to hint at TTS.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speech-bubble arc (subtle, behind the letter) -->
    <path
        android:pathData="M30,72 Q24,72 24,66 L24,42 Q24,36 30,36 L78,36 Q84,36 84,42 L84,66 Q84,72 78,72 L60,72 L54,80 L50,72 Z"
        android:fillColor="#BBFFFFFF"/>

    <!-- Devanagari म  — hand-tuned to ~28dp cap-height, centered -->
    <!-- Shirorekha (top headline bar) -->
    <path
        android:pathData="M36,42 L72,42 L72,44.5 L36,44.5 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Left vertical stem -->
    <path
        android:pathData="M40,44.5 L42.5,44.5 L42.5,66 L40,66 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Right vertical stem -->
    <path
        android:pathData="M65.5,44.5 L68,44.5 L68,66 L65.5,66 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Curved belly of म (connecting arc) -->
    <path
        android:pathData="M42.5,52 Q54,64 65.5,52"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF"
        android:fillColor="#00000000"/>

    <!-- Small inner loop on left shoulder -->
    <path
        android:pathData="M42.5,44.5 Q46,48 42.5,52"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:fillColor="#00000000"/>

</vector>
